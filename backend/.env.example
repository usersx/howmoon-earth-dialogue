# Preferred provider. The same Key powers dialogue and Qwen-ASR.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_ASR_MODEL=qwen3-asr-flash

# Optional DeepSeek fallback provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90

# Keep true for a deterministic local fallback when no DeepSeek key is configured.
ALLOW_MOCK_DIALOGUE=true
MOCK_THINKING_DELAY_SECONDS=2.6
MIN_PROVIDER_THINKING_DELAY_SECONDS=1.2

# Optional OpenAI-compatible speech-to-text provider when Qwen is not configured.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
