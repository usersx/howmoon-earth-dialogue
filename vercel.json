{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python scripts/prepare_vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 180,
      "excludeFiles": "{backend/tests/**,backend/.venv/**,recovered/**,docs/**,scripts/**,site/assets/**,public/**}"
    }
  }
}
